# Copia este archivo como .env y completa la URL de tu proyecto Supabase.
# No subas el archivo .env a GitHub.
# Para el pooler transaccional de Supabase (normalmente puerto 6543), NO agregues ?pgbouncer=true.
# Si la contraseña contiene caracteres especiales, codifícalos para URL.
DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASENA@HOST_POOLER:6543/postgres
# Impuesto de ejemplo configurable; confirma la tasa que exige tu proyecto.
TAX_RATE=0.15
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
